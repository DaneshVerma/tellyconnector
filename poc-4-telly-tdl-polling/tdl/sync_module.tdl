;; sync_module.tdl
;; Import-safe minimal TDL skeleton.
;; The original version used event/timer forms that are not accepted by every TallyPrime build.
;; This revised file removes the unsupported definition types so the module can import cleanly.
;; The real HTTP/XML logic should be added only after confirming the exact syntax supported by your build.

[System: UDF]

;; ------------------------------------------------------------------
;; Minimal screen to keep open while testing the middleware
;; ------------------------------------------------------------------
[Report: SyncMonitor]
    Form: SyncMonitorForm
    Title: "Tally Sync Monitor"

[Form: SyncMonitorForm]
    Part: SyncMonitorPart

[Part: SyncMonitorPart]
    Line: SyncMonitorLine

[Line: SyncMonitorLine]
    Field: SyncMonitorField

[Field: SyncMonitorField]
    Use: Short Name
    Set As: "This report keeps the testing screen open"

;; ------------------------------------------------------------------
;; Safe, import-friendly TDL structure only.
;; The original push/poll examples are intentionally left as comments below.
;; ------------------------------------------------------------------

;; For the real working version, add the Tally-specific syntax supported by your TallyPrime build:
;; - voucher-save trigger (On Form Accept / Save event)
;; - timer-based polling while this report is open
;; - HTTP GET/POST to localhost:3000
;; - XML import for creating ledger masters
;; - ack POST back to /tally/ack
;; Those are valid concepts, but the exact TDL definition names vary by build.

;; Example placeholders (do not uncomment unless your build supports them exactly):
;; [Event: OnVoucherSave]
;; [System: Timer]
;; [Function: SendVoucherToMiddleware]
;; [Function: PollMiddlewareAndApply]

;; End of import-safe module.
